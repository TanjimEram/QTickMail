    var s=(r[cfg.sentCol-1]||'').toString().trim();
    if((r[cfg.pdfCol-1]||'').toString().trim()) pdfs++;
    if(/^FAILED/i.test(s)) failed++; else if(s!=='') done++; else todo++;
  });
  Logger.log('['+ACCOUNT_LABEL+'] '+cfg.code+' → PDFs '+pdfs+' | SENT '+done+' | FAILED '+failed+' | not-yet '+todo+' | quota left '+MailApp.getRemainingDailyQuota());
}

function mxCapLeftToday(){
  const p=PropertiesService.getScriptProperties();
  const today=Utilities.formatDate(new Date(), Session.getScriptTimeZone(),'yyyy-MM-dd');
  if(p.getProperty('mxDay')!==today){ p.setProperty('mxDay',today); p.setProperty('mxCount','0'); }
  return DAILY_CAP - parseInt(p.getProperty('mxCount')||'0',10);
}
function mxBumpToday(n){
  n = n || 1;
  const p=PropertiesService.getScriptProperties();
  const today=Utilities.formatDate(new Date(), Session.getScriptTimeZone(),'yyyy-MM-dd');
  if(p.getProperty('mxDay')!==today){ p.setProperty('mxDay',today); p.setProperty('mxCount',String(n)); }
  else p.setProperty('mxCount', String(parseInt(p.getProperty('mxCount')||'0',10)+n));
}

