function sendCase(cfg){
  const sheet=getSS().getSheetByName(SHEET_NAME);
  const lastRow=sheet.getLastRow(); if(lastRow<2){ Logger.log('No data rows.'); return; }
  const startRow=Math.max(2, RANGE_START||2);
  const endRow=(RANGE_END&&RANGE_END>0)?Math.min(RANGE_END,lastRow):lastRow;
  if(startRow>endRow){ Logger.log('Range empty.'); return; }
  const rows=sheet.getRange(startRow,1,endRow-startRow+1,READ_COLS).getValues();

  let capLeft=mxCapLeftToday();
  if(capLeft<=0){ Logger.log('['+ACCOUNT_LABEL+'] Daily cap '+DAILY_CAP+' reached. Rest tomorrow.'); return; }
  let remaining=MailApp.getRemainingDailyQuota();
  if(remaining<=0){ Logger.log('['+ACCOUNT_LABEL+'] Gmail quota exhausted today.'); return; }
  Logger.log('['+ACCOUNT_LABEL+'] CASE rows '+startRow+'-'+endRow+' | quota '+remaining+' | cap left '+capLeft);

  let teams=0, sent=0, failed=0, bad=0, already=0, usedRec=0;
  for(let i=0;i<rows.length;i++){
    if(teams>=MAX_PER_RUN){ Logger.log('Hit MAX_PER_RUN.'); break; }
    const rowNum=startRow+i;
    const team=(rows[i][COL_TEAM-1]||'').toString().trim();
    const leader=(rows[i][COL_LEADER-1]||'').toString().trim();
    const email=(rows[i][COL_EMAIL-1]||'').toString().trim();
    const status=(rows[i][CASE_STATUS_COL-1]||'').toString().trim();
    const isBad=/^(FAILED|BOUNCED)/i.test(status);
    if(status!=='' && !isBad){ already++; continue; }
    if(!email){ sheet.getRange(rowNum,CASE_STATUS_COL).setValue('FAILED '+stamp()+' ['+ACCOUNT_LABEL+'] no email'); bad++; continue; }
    if(!EMAIL_RE.test(email)){ sheet.getRange(rowNum,CASE_STATUS_COL).setValue('FAILED '+stamp()+' ['+ACCOUNT_LABEL+'] bad format: '+email); bad++; continue; }

    const bcc=collectMemberEmails(rows[i], email);
    const recips=1+bcc.length;
    if(usedRec+recips>capLeft){ Logger.log('Would exceed daily cap. Stop; run again tomorrow.'); break; }
    if(usedRec+recips>remaining){ Logger.log('Would exceed Gmail quota. Stop; run again.'); break; }

    try{
      var opts={ htmlBody:cfg.body(team,leader), name:'MarXcellence 2026 — NSU MIBC' };
      if(bcc.length) opts.bcc=bcc.join(',');
      GmailApp.sendEmail(email, cfg.subject, 'Please view this email in HTML.', opts);
      sheet.getRange(rowNum,CASE_STATUS_COL).setValue('SENT '+stamp()+' ['+ACCOUNT_LABEL+']'+(bcc.length?(' +'+bcc.length+'bcc'):''));
      usedRec+=recips; mxBumpToday(recips); teams++; sent++;
    }catch(err){
      sheet.getRange(rowNum,CASE_STATUS_COL).setValue('FAILED '+stamp()+' ['+ACCOUNT_LABEL+'] '+shortErr(err));
      failed++; Logger.log('Row '+rowNum+' ("'+team+'") CASE FAILED: '+err);
    }
  }
  Logger.log('['+ACCOUNT_LABEL+'] CASE done. Sent '+sent+' teams ('+usedRec+' recipients) | send-failed '+failed+' | bad-address '+bad+' | already '+already);
}

// ---- MEMBERS ONLY (leader excluded) → Column Z. Skips teams already Bcc'd in Column R. ----
function sendCaseToMembers(cfg){
  const sheet=getSS().getSheetByName(SHEET_NAME);
  const lastRow=sheet.getLastRow(); if(lastRow<2){ Logger.log('No data rows.'); return; }
  const startRow=Math.max(2, RANGE_START||2);
  const endRow=(RANGE_END&&RANGE_END>0)?Math.min(RANGE_END,lastRow):lastRow;
  if(startRow>endRow){ Logger.log('Range empty.'); return; }
  const rows=sheet.getRange(startRow,1,endRow-startRow+1,READ_COLS).getValues();

  let capLeft=mxCapLeftToday();
  if(capLeft<=0){ Logger.log('['+ACCOUNT_LABEL+'] Daily cap reached. Rest tomorrow.'); return; }
  let remaining=MailApp.getRemainingDailyQuota();
  if(remaining<=0){ Logger.log('['+ACCOUNT_LABEL+'] Gmail quota exhausted today.'); return; }
  Logger.log('['+ACCOUNT_LABEL+'] MEMBERS-ONLY rows '+startRow+'-'+endRow+' | quota '+remaining+' | cap left '+capLeft);

  let teams=0, sent=0, failed=0, none=0, already=0, usedRec=0;
  for(let i=0;i<rows.length;i++){
    if(teams>=MAX_PER_RUN){ Logger.log('Hit MAX_PER_RUN.'); break; }
    const rowNum=startRow+i;
    const team=(rows[i][COL_TEAM-1]||'').toString().trim();
    const leader=(rows[i][COL_LEADER-1]||'').toString().trim();
    const leaderEmail=(rows[i][COL_EMAIL-1]||'').toString().trim();
    const zstatus=(rows[i][MEMBER_STATUS_COL-1]||'').toString().trim();
    const rstatus=(rows[i][CASE_STATUS_COL-1]||'').toString();
    const zBad=/^(FAILED|BOUNCED)/i.test(zstatus);

    if(zstatus!=='' && !zBad){ already++; continue; }
    if(/bcc/i.test(rstatus)){ already++; continue; }

    const members=collectMemberEmails(rows[i], leaderEmail);
    if(members.length===0){ sheet.getRange(rowNum,MEMBER_STATUS_COL).setValue('NO MEMBERS '+stamp()+' ['+ACCOUNT_LABEL+']'); none++; continue; }

    const recips=members.length;
    if(usedRec+recips>capLeft){ Logger.log('Would exceed daily cap. Stop.'); break; }
    if(usedRec+recips>remaining){ Logger.log('Would exceed Gmail quota. Stop.'); break; }

    try{
      var to=members[0], bcc=members.slice(1);
      var opts={ htmlBody:cfg.body(team,leader), name:'MarXcellence 2026 — NSU MIBC' };
      if(bcc.length) opts.bcc=bcc.join(',');
      GmailApp.sendEmail(to, cfg.subject, 'Please view this email in HTML.', opts);
      sheet.getRange(rowNum,MEMBER_STATUS_COL).setValue('SENT '+stamp()+' ['+ACCOUNT_LABEL+'] '+members.length+'mem');
      usedRec+=recips; mxBumpToday(recips); teams++; sent++;
    }catch(err){
      sheet.getRange(rowNum,MEMBER_STATUS_COL).setValue('FAILED '+stamp()+' ['+ACCOUNT_LABEL+'] '+shortErr(err));
      failed++; Logger.log('Row '+rowNum+' ("'+team+'") MEMBERS FAILED: '+err);
    }
  }
  Logger.log('['+ACCOUNT_LABEL+'] MEMBERS-ONLY done. Sent '+sent+' teams ('+usedRec+' recipients) | failed '+failed+' | no-members '+none+' | already '+already);
}

