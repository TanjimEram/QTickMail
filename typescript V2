// Collect valid member emails (F/I/L), skipping blanks, bad formats, and any that equal excludeEmail
function collectMemberEmails(rowArr, excludeEmail){
  const cols=[COL_M2_EMAIL, COL_M3_EMAIL, COL_M4_EMAIL];
  const seen={}; if(excludeEmail) seen[excludeEmail.toString().trim().toLowerCase()]=1;
  const out=[];
  for(var k=0;k<cols.length;k++){
    var e=(rowArr[cols[k]-1]||'').toString().trim();
    var lc=e.toLowerCase();
    if(e && EMAIL_RE.test(e) && !seen[lc]){ out.push(e); seen[lc]=1; }
  }
  return out;
}

