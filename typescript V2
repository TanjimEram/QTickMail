// ---- GENERATION ----
function generateTickets(cfg){
  const sheet=getSS().getSheetByName(SHEET_NAME);
  const lastRow=sheet.getLastRow(); if(lastRow<2){ Logger.log('No data.'); return; }
  const startRow=Math.max(2,RANGE_START||2);
  const endRow=(RANGE_END&&RANGE_END>0)?Math.min(RANGE_END,lastRow):lastRow;
  if(startRow>endRow){ Logger.log('Range empty.'); return; }
  const rows=sheet.getRange(startRow,1,endRow-startRow+1,READ_COLS).getValues();
  let made=0, have=0, skip=0;
  for(let i=0;i<rows.length;i++){
    if(made>=MAX_GEN_PER_RUN){ Logger.log('Gen batch limit hit; continues next run.'); break; }
    const rowNum=startRow+i;
    const team=(rows[i][COL_TEAM-1]||'').toString().trim();
    const leader=(rows[i][COL_LEADER-1]||'').toString().trim();
    const email=(rows[i][COL_EMAIL-1]||'').toString().trim();
    const existing=(rows[i][cfg.pdfCol-1]||'').toString().trim();
    const qual=cfg.qualifiedCol ? (rows[i][cfg.qualifiedCol-1]||'').toString().trim().toUpperCase() : 'YES';
    if(existing){ have++; continue; }
    if(cfg.qualifiedCol && qual!=='YES'){ skip++; continue; }
    if(!team||!email){ skip++; continue; }
    try{ const id=makeTicketPdf(cfg, team, leader); sheet.getRange(rowNum, cfg.pdfCol).setValue(id); made++; }
    catch(err){ Logger.log('Row '+rowNum+' ("'+team+'") GEN FAILED: '+err); }
  }
  Logger.log('['+ACCOUNT_LABEL+'] '+cfg.code+' generation → made '+made+' | already had '+have+' | skipped '+skip);
}

function makeTicketPdf(cfg, team, leader){
  const checkinUrl=WEBAPP_URL+'?team='+encodeURIComponent(team)+'&leader='+encodeURIComponent(leader)+'&w='+encodeURIComponent(cfg.code);
  const qrBlob=UrlFetchApp.fetch('https://quickchart.io/qr?size=500&margin=2&text='+encodeURIComponent(checkinUrl)).getBlob();
  const folder=DriveApp.getFolderById(FOLDER_ID);
  const copyFile=DriveApp.getFileById(cfg.templateId).makeCopy(team+'_'+cfg.code+'_Ticket', folder);
  const deck=SlidesApp.openById(copyFile.getId());
  deck.replaceAllText('{{TEAM_NAME}}',team);
  deck.replaceAllText('{{LEADER_NAME}}',leader);
  const imgs=deck.getSlides()[0].getImages();
  let target=null;
  for(let i=0;i<imgs.length;i++){ const tag=((imgs[i].getTitle()||'')+' '+(imgs[i].getDescription()||'')).toUpperCase(); if(tag.indexOf('QR')>-1){ target=imgs[i]; break; } }
  if(!target && imgs.length===1) target=imgs[0];
  if(target) target.replace(qrBlob); else Logger.log('WARNING: no QR image for '+team);
  deck.saveAndClose();
  const pdf=DriveApp.getFileById(copyFile.getId()).getAs('application/pdf').setName(team+'_'+cfg.code+'_Ticket.pdf');
  const pdfFile=folder.createFile(pdf);
  try{ copyFile.setTrashed(true); }catch(e){}
  return pdfFile.getId();
}

// ---- SENDING TICKETS (leader = To, members = Bcc) ----
function sendTickets(cfg){
  const sheet=getSS().getSheetByName(SHEET_NAME);
  const lastRow=sheet.getLastRow(); if(lastRow<2){ Logger.log('No data rows.'); return; }
  const startRow=Math.max(2, RANGE_START||2);
  const endRow=(RANGE_END&&RANGE_END>0)?Math.min(RANGE_END,lastRow):lastRow;
  if(startRow>endRow){ Logger.log('Range empty.'); return; }
  const rows=sheet.getRange(startRow,1,endRow-startRow+1,READ_COLS).getValues();

  let capLeft=mxCapLeftToday();
  if(capLeft<=0){ Logger.log('['+ACCOUNT_LABEL+'] Daily cap '+DAILY_CAP+' reached. Rest tomorrow.'); return; }
  let remaining=MailApp.getRemainingDailyQuota();
  if(remaining<=0){ Logger.log('['+ACCOUNT_LABEL+'] Gmail quota exhausted for today.'); return; }
  Logger.log('['+ACCOUNT_LABEL+'] '+cfg.code+' rows '+startRow+'-'+endRow+' | quota '+remaining+' | cap left '+capLeft);

  let teams=0, sent=0, failed=0, already=0, skipped=0, waiting=0, usedRec=0;
  for(let i=0;i<rows.length;i++){
    if(teams>=MAX_PER_RUN){ Logger.log('Hit MAX_PER_RUN.'); break; }
    const rowNum=startRow+i;
    const team=(rows[i][COL_TEAM-1]||'').toString().trim();
    const leader=(rows[i][COL_LEADER-1]||'').toString().trim();
    const email=(rows[i][COL_EMAIL-1]||'').toString().trim();
    const status=(rows[i][cfg.sentCol-1]||'').toString().trim();
    const pdfId=(rows[i][cfg.pdfCol-1]||'').toString().trim();
    const isFailed=/^FAILED/i.test(status);
    const isDone=(status!=='' && !isFailed);
    const qual=cfg.qualifiedCol ? (rows[i][cfg.qualifiedCol-1]||'').toString().trim().toUpperCase() : 'YES';

    if(isDone){ already++; continue; }
    if(cfg.qualifiedCol && qual!=='YES'){ skipped++; continue; }
    if(!team||!email){ sheet.getRange(rowNum, cfg.sentCol).setValue('FAILED '+stamp()+' ['+ACCOUNT_LABEL+'] missing team/email'); failed++; continue; }
    if(PDF_LOOKUP && !pdfId){ waiting++; continue; }

    const bcc=collectMemberEmails(rows[i], email);
    const recips=1+bcc.length;
    if(usedRec+recips>capLeft){ Logger.log('Would exceed daily cap. Stop; run again tomorrow.'); break; }
    if(usedRec+recips>remaining){ Logger.log('Would exceed Gmail quota. Stop; run again.'); break; }

    try{
      buildAndSend(cfg, team, leader, email, pdfId, bcc);
      sheet.getRange(rowNum, cfg.sentCol).setValue('SENT '+stamp()+' ['+ACCOUNT_LABEL+']'+(bcc.length?(' +'+bcc.length+'bcc'):''));
      usedRec+=recips; mxBumpToday(recips); teams++; sent++;
    }catch(err){
      sheet.getRange(rowNum, cfg.sentCol).setValue('FAILED '+stamp()+' ['+ACCOUNT_LABEL+'] '+shortErr(err));
      failed++; Logger.log('Row '+rowNum+' ("'+team+'") SEND FAILED: '+err);
    }
  }
  Logger.log('['+ACCOUNT_LABEL+'] '+cfg.code+' done. Sent '+sent+' teams ('+usedRec+' recipients) | failed '+failed+' | already '+already+' | not-qualified '+skipped+' | waiting-for-PDF '+waiting);
}

function buildAndSend(cfg, team, leader, email, pdfId, bcc){
  let pdfBlob;
  if(pdfId){ pdfBlob = DriveApp.getFileById(pdfId).getBlob().setName(team+'_'+cfg.code+'_Ticket.pdf'); }
  else if(PDF_LOOKUP){ throw new Error('No pre-generated PDF yet for this row'); }
  else { const id = makeTicketPdf(cfg, team, leader); pdfBlob = DriveApp.getFileById(id).getBlob().setName(team+'_'+cfg.code+'_Ticket.pdf'); }
  var opts={ htmlBody:cfg.body(team,leader), attachments:[pdfBlob], name:'Marxcellence 2026' };
  if(bcc && bcc.length) opts.bcc=bcc.join(',');
  GmailApp.sendEmail(email, cfg.subject, 'Your Marxcellence 2026 ticket is attached.', opts);
}

