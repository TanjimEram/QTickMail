  const startRow=Math.max(2, RANGE_START||2);
  const endRow=(RANGE_END&&RANGE_END>0)?Math.min(RANGE_END,lastRow):lastRow;
  const vals=sheet.getRange(startRow,1,endRow-startRow+1,READ_COLS).getValues();
  let done=0, failed=0, bounced=0, todo=0;
  vals.forEach(function(r){ var s=(r[CASE_STATUS_COL-1]||'').toString().trim();
    if(/^BOUNCED/i.test(s)) bounced++; else if(/^FAILED/i.test(s)) failed++; else if(s!=='') done++; else todo++; });
  Logger.log('['+ACCOUNT_LABEL+'] CASE (R) → SENT '+done+' | FAILED '+failed+' | BOUNCED '+bounced+' | not-yet '+todo+' | quota left '+MailApp.getRemainingDailyQuota());
}

